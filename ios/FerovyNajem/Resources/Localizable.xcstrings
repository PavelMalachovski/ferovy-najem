        }
      }
    },
    "Ask the landlord for the unit number (číslo jednotky) or the LV number. A genuine owner can give it right away.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Požádejte pronajímatele o číslo jednotky nebo číslo LV. Skutečný vlastník ho dá hned."
