        }
      }
    },
    "Different name? Ask for a power of attorney or the lease between the owner and the landlord.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jiné jméno? Požádejte o plnou moc nebo o nájemní smlouvu mezi vlastníkem a pronajímatelem."
          }
        }
      }
    },
    "Do they want a deposit before you see the flat in person?": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chtějí kauci dřív, než byt uvidíte osobně?"
