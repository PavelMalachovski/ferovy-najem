# Copy to .env (gitignored) and fill in. Never commit real values.

# --- Postgres (docker compose) ---
POSTGRES_DB=ferovy
POSTGRES_USER=ferovy
POSTGRES_PASSWORD=ferovy
# Used by the backend when run outside compose (pytest, scripts, uvicorn on host)
DATABASE_URL=postgresql+psycopg://ferovy:ferovy@localhost:5432/ferovy

# --- ČÚZK API KN (https://api-kn.cuzk.gov.cz) ---
CUZK_API_KEY=
CUZK_API_BASE_URL=https://api-kn.cuzk.gov.cz/api/v1

# --- App ---
ENV=dev
# JSON list, e.g. ["https://app.example.cz"]; empty in MVP
CORS_ALLOW_ORIGINS=[]
# Random string, secret in production (hashing IPs for rate limits)
RATE_LIMIT_SALT=dev-only-change-me
# Overrides use '__', e.g. SCORING__PRICE_RED_BELOW=0.65, PROTECTION__REPORT_PER_IP_PER_HOUR=20

# --- App Attest (M4); keep disabled for Simulator/dev ---
PROTECTION__ATTESTATION_MODE=disabled
# PROTECTION__APP_ATTEST_APP_ID=<TeamID>.cz.ferovynajem.app
# PROTECTION__APP_ATTEST_ENVIRONMENT=production

# --- Alerts (always logged; Telegram if both set) ---
# OPS__ALERT_TELEGRAM_BOT_TOKEN=
# OPS__ALERT_TELEGRAM_CHAT_ID=
